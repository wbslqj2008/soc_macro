<ui:FluentWindow x:Class="SocMacro.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="소오콘 매크로" Width="980" Height="700" MinWidth="820" MinHeight="560"
                 WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RowDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="MinWidth" Value="200" />
        </Style>
        <Style x:Key="NumberBox" TargetType="ui:TextBox" BasedOn="{StaticResource {x:Type ui:TextBox}}">
            <Setter Property="Width" Value="90" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="소오콘 매크로" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- navigation -->
            <DockPanel Grid.Column="0" Margin="8,4,4,12">
                <Border DockPanel.Dock="Bottom" Margin="8,0" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="SideDot" Width="9" Height="9" Fill="#8A8A8A" VerticalAlignment="Center" />
                            <TextBlock x:Name="SideStatus" Text="대기 중" Margin="8,0,0,0" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock x:Name="SideLicense" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" BorderThickness="0" Background="Transparent">
                    <ListBoxItem Tag="Dashboard" IsSelected="True">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Home24" />
                            <TextBlock Text="대시보드" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Journey">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Map24" />
                            <TextBlock Text="탐험의 여정" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Daily">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="CalendarLtr24" />
                            <TextBlock x:Name="DailyNavLabel" Text="일일퀘스트" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Settings">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Settings24" />
                            <TextBlock Text="설정" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Log">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="TextBulletListLtr24" />
                            <TextBlock Text="로그" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="Account">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Key24" />
                            <TextBlock Text="라이센스" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem x:Name="AdminNav" Tag="Admin" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="4,6">
                            <ui:SymbolIcon Symbol="Shield24" />
                            <TextBlock Text="관리자" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1" Margin="12,0,20,16">

                <!-- 대시보드 -->
                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="대시보드" Style="{StaticResource PageTitle}" />

                        <ui:Card Padding="20">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button x:Name="StartButton" Appearance="Primary" Content="탐험 시작" Width="120" Height="40"
                                               Margin="0,0,8,0" Click="Start_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Play24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="DailyButton" Content="일일퀘스트" Width="120" Height="40"
                                               Margin="0,0,8,0" Click="StartDaily_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="CalendarLtr24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:Button x:Name="StopButton" Appearance="Danger" Content="정지" Width="110" Height="40"
                                               IsEnabled="False" Click="Stop_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="Stop24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="#8A8A8A" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StatusText" Text="대기 중" FontSize="20" FontWeight="SemiBold" Margin="10,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock x:Name="StepText" Text="F9로 시작, F10으로 정지합니다." Margin="22,6,0,0" FontSize="13"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DockPanel>
                        </ui:Card>

                        <ui:InfoBar x:Name="AlertBar" Title="확인이 필요합니다" Severity="Warning" IsOpen="False"
                                    IsClosable="True" Margin="0,12,0,0" />

                        <UniformGrid Columns="3" Margin="0,12,0,0">
                            <ui:Card Margin="0,0,6,0" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Trophy24" FontSize="16" />
                                        <TextBlock Text="완료한 탐험" Margin="8,0,0,0" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <TextBlock x:Name="RoundText" Text="0회" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="3,0,3,0" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Timer24" FontSize="16" />
                                        <TextBlock Text="실행 시간" Margin="8,0,0,0" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ElapsedText" Text="00:00:00" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Margin="6,0,0,0" Padding="18">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flash24" FontSize="16" />
                                        <TextBlock Text="행동력" Margin="8,0,0,0" Style="{StaticResource StatLabel}" />
                                    </StackPanel>
                                    <TextBlock x:Name="StaminaText" Text="-" Style="{StaticResource StatValue}" />
                                </StackPanel>
                            </ui:Card>
                        </UniformGrid>

                        <TextBlock Text="최근 기록" Style="{StaticResource Section}" />
                        <ui:Card Padding="12">
                            <Grid>
                            <TextBlock x:Name="RecentEmpty" Text="아직 기록이 없습니다. 시작하면 진행 상황이 여기에 표시됩니다." FontSize="12"
                                       Margin="0,3" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <ItemsControl x:Name="RecentLog" FontFamily="Consolas, Malgun Gothic" FontSize="12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Margin="0,3" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Grid>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- 탐험의 여정 -->
                <ScrollViewer x:Name="JourneyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <DockPanel Margin="0,0,0,16">
                            <ui:ToggleSwitch x:Name="JourneyEnabled" DockPanel.Dock="Right" OnContent="사용" OffContent="사용 안 함" />
                            <TextBlock Text="탐험의 여정" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <TextBlock Text="진행" Style="{StaticResource Section}" Margin="0,0,0,8" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Flag24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="난이도" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="입장할 스테이지" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="Stage">
                                <ComboBoxItem Content="난이도 1" />
                                <ComboBoxItem Content="스테이지 2" />
                                <ComboBoxItem Content="스테이지 3" />
                                <ComboBoxItem Content="스테이지 4" />
                                <ComboBoxItem Content="스테이지 5" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Shield24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="탐험 장르" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="탐험 시작 시 고르는 유파" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="Genre">
                                <ComboBoxItem Content="쏜살같이" />
                                <ComboBoxItem Content="견고함" />
                                <ComboBoxItem Content="화력 집중" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowRepeatAll24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="반복 횟수" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="0이면 멈출 때까지 계속 반복" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="MaxRounds" Style="{StaticResource NumberBox}" />
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Gift24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="고급 보상 받기" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="고급 보상권이 있으면 고급 보상, 없으면 클리어 포인트로 교환" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UseAdvancedReward" />
                        </ui:CardControl>

                        <TextBlock Text="축복 선택" Style="{StaticResource Section}" />
                        <ui:Card Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="우선 키워드" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="한 줄에 하나, 위에 있을수록 우선" Style="{StaticResource RowDesc}" />
                                    <ui:TextBox x:Name="BlessingKeywords" AcceptsReturn="True" Height="120" Margin="0,8,0,0"
                                                VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="제외 키워드" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="이 글자가 들어간 카드는 고르지 않음 (예: 받는 대미지가, 감소한다)" Style="{StaticResource RowDesc}" />
                                    <ui:TextBox x:Name="BlessingExcludes" AcceptsReturn="True" Height="120" Margin="0,8,0,0"
                                                VerticalContentAlignment="Top" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                        <ui:CardControl Margin="0,4,0,4">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="키워드가 없을 때" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="어느 카드에도 키워드가 없으면 고를 위치" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="BlessingFallback">
                                <ComboBoxItem Content="첫 번째 카드" />
                                <ComboBoxItem Content="두 번째 카드" />
                                <ComboBoxItem Content="세 번째 카드" />
                            </ComboBox>
                        </ui:CardControl>

                        <TextBlock Text="패배 시" Style="{StaticResource Section}" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Warning24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="같은 전투 패배 허용 횟수" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="이만큼 지면 진행도를 포기하고 처음부터 다시 시작" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="MaxLosses" Style="{StaticResource NumberBox}" />
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowSwap24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="재도전 시 자리 바꿀 쌍 수" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="무작위로 고른 서로 다른 아군끼리 자리를 바꿉니다. 같은 캐릭터를 두 번 옮기지 않아 원래 배치로 돌아가지 않습니다. (6명이면 최대 3쌍)" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="Swaps" Style="{StaticResource NumberBox}" />
                        </ui:CardControl>

                        <TextBlock Text="행동력 (존재의 힘)" Style="{StaticResource Section}" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Drop24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="존재의 힘 결정 사용" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="보유한 경우 1개 사용 (+100)" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UseStaminaItem" />
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Diamond24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="희망의 결정석으로 구매" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="하루 최대 구매 횟수 (회당 +120, 결정석 60 / 120 / 200 / 320)" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="GemLimit" MinWidth="220">
                                <ComboBoxItem Content="사용 안 함" />
                                <ComboBoxItem Content="하루 1회 (누적 60)" />
                                <ComboBoxItem Content="하루 2회 (누적 180)" />
                                <ComboBoxItem Content="하루 3회 (누적 380)" />
                                <ComboBoxItem Content="하루 4회 (누적 700)" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Hourglass24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="회복 대기 중 입력 차단 해제" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="보충 수단을 다 쓰면 120이 될 때까지 기다립니다. 그동안 PC를 쓸 수 있게 합니다." Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UnblockWhileWaiting" />
                        </ui:CardControl>

                        <TextBlock Text="부가 기능" Style="{StaticResource Section}" />
                        <ui:CardControl IsEnabled="False">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Ribbon24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="탐험 레벨 보상 자동 수령" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="준비 중" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ClaimLevelRewards" />
                        </ui:CardControl>
                        <ui:CardControl IsEnabled="False">
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Cart24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="탐험 보급소 자동 구매" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="준비 중" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="BuySupplyShop" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 일일퀘스트 -->
                <ScrollViewer x:Name="DailyPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <DockPanel Margin="0,0,0,16">
                            <ui:Button DockPanel.Dock="Right" Appearance="Primary" Content="일일퀘스트 시작" Click="StartDaily_Click">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Play24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Text="일일퀘스트" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <TextBlock Text="공통" Style="{StaticResource Section}" Margin="0,0,0,8" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Gift24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="문어 통조림 사용" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="소탕을 즉시 완료합니다. 통조림이 없거나 부족하면 계속 소탕으로 횟수를 채웁니다." Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="UseOctopusCan" />
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Clock24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="탐험 중 00시가 지나면 일일퀘스트 실행" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="진행 중인 탐험을 마친 뒤 일일퀘스트를 하고, 탐험 반복으로 돌아갑니다." Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="DailyAfterReset" />
                        </ui:CardControl>

                        <TextBlock Text="컨텐츠 (위에서부터 순서대로 진행)" Style="{StaticResource Section}" />
                        <StackPanel x:Name="DailyPanel" />

                        <TextBlock Text="알림판" Style="{StaticResource Section}" />
                        <ui:Card Padding="16,12,16,12">
                            <StackPanel>
                                <DockPanel>
                                    <ui:ToggleSwitch x:Name="GloryEnabled" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="글로리 전장" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="일일퀘스트 다음에 진행 · 자동 전투 · 하루 최대 5회 (게임의 남은 도전 횟수가 0이면 멈춤)" Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="난이도" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="GloryDifficulty" MinWidth="140" Margin="0,0,24,0">
                                        <ComboBoxItem Content="쉬움 (×1)" />
                                        <ComboBoxItem Content="일반 (×1.3)" />
                                        <ComboBoxItem Content="어려움 (×1.8)" />
                                    </ComboBox>
                                    <TextBlock Text="횟수" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="GloryCount" MinWidth="90">
                                        <ComboBoxItem Content="1회" />
                                        <ComboBoxItem Content="2회" />
                                        <ComboBoxItem Content="3회" />
                                        <ComboBoxItem Content="4회" />
                                        <ComboBoxItem Content="5회" />
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- 설정 -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="설정" Style="{StaticResource PageTitle}" />

                        <TextBlock Text="게임 실행" Style="{StaticResource Section}" Margin="0,0,0,8" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Games24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="실행 방식" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="게임이 꺼져 있을 때 어떤 클라이언트로 실행할지" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LaunchOfficial" Content="공식 런처" GroupName="Launch" Margin="0,0,12,0" />
                                <RadioButton x:Name="LaunchSteam" Content="Steam" GroupName="Launch" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:Card Padding="16" Margin="0,0,0,4">
                            <StackPanel>
                                <TextBlock Text="공식 런처 경로 (XD.exe)" Style="{StaticResource RowTitle}" />
                                <DockPanel Margin="0,8,0,0">
                                    <ui:Button DockPanel.Dock="Right" Content="찾아보기" Margin="8,0,0,0" Click="Browse_Click">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                    <ui:TextBox x:Name="OfficialPath" />
                                </DockPanel>
                            </StackPanel>
                        </ui:Card>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ArrowClockwise24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="게임 자동 실행" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="게임이 꺼져 있거나 튕기면 자동으로 다시 실행" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutoLaunch" />
                        </ui:CardControl>

                        <TextBlock Text="화면" Style="{StaticResource Section}" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Window24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="화면 모드" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="게임에서 쓰는 화면 모드" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="Display">
                                <ComboBoxItem Content="창 모드" />
                                <ComboBoxItem Content="전체 화면" />
                            </ComboBox>
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Desktop24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="게임 해상도 (16:9)" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="'자동'은 현재 창 크기 그대로. 창 모드에서 고르면 시작할 때 게임 창 크기를 맞춥니다." Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="Resolution" IsEditable="True" />
                        </ui:CardControl>
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="ScanCamera24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="게임 화면 감지" Style="{StaticResource RowTitle}" />
                                    <TextBlock x:Name="DetectText" Text="게임 창 크기와 Windows 배율을 확인합니다. 배율은 자동으로 보정됩니다." Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Content="감지" Click="Detect_Click" />
                        </ui:CardControl>

                        <TextBlock Text="입력" Style="{StaticResource Section}" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="동작 중 마우스·키보드 차단" Style="{StaticResource RowTitle}" />
                                    <TextBlock Text="실수로 게임을 건드리지 않도록 막습니다. F10(정지)은 항상 동작합니다." Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="BlockInput" />
                        </ui:CardControl>

                        <TextBlock Text="예약 실행" Style="{StaticResource Section}" />
                        <ui:Card Padding="16,12,16,12">
                            <StackPanel>
                                <DockPanel>
                                    <ui:ToggleSwitch x:Name="ScheduleEnabled" DockPanel.Dock="Right" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="정해진 시각에 자동 시작" Style="{StaticResource RowTitle}" />
                                        <TextBlock Text="한국 시간(KST) 기준. PC와 이 프로그램이 켜져 있을 때만 실행됩니다. 예약 시각부터 10분 안에 켜져 있지 않았으면 그날은 건너뜁니다. 이미 실행 중이면 건너뜁니다."
                                                   Style="{StaticResource RowDesc}" />
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Text="시각" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="ScheduleHour" MinWidth="80" Margin="0,0,4,0" />
                                    <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <ComboBox x:Name="ScheduleMinute" MinWidth="80" Margin="0,0,24,0" />
                                    <TextBlock Text="실행할 작업" Style="{StaticResource RowDesc}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <ComboBox x:Name="ScheduleMode" MinWidth="150">
                                        <ComboBoxItem Content="탐험의 여정" />
                                        <ComboBoxItem x:Name="ScheduleModeDaily" Content="일일퀘스트 (프로)" />
                                    </ComboBox>
                                </StackPanel>
                                <WrapPanel x:Name="ScheduleDaysPanel" Margin="0,12,0,0" />
                                <TextBlock x:Name="ScheduleNext" Style="{StaticResource RowDesc}" Margin="0,8,0,0" />
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- 계정 -->
                <ScrollViewer x:Name="AccountPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="라이센스" Style="{StaticResource PageTitle}" />
                        <ui:CardControl>
                            <ui:CardControl.Icon><ui:SymbolIcon Symbol="Key24" /></ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock x:Name="AccountKey" Style="{StaticResource RowTitle}" FontFamily="Consolas, Malgun Gothic" />
                                    <TextBlock x:Name="AccountStatus" Style="{StaticResource RowDesc}" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="새로고침" Margin="0,0,8,0" Click="RefreshLicense_Click" />
                                <ui:Button Content="다른 키 입력" Click="Logout_Click" />
                            </StackPanel>
                        </ui:CardControl>
                        <ui:InfoBar x:Name="BasicInfo" Title="베이직 키" Severity="Informational" IsOpen="False" IsClosable="False" Margin="0,8,0,0"
                                    Message="베이직 키는 탐험의 여정만 사용할 수 있습니다. 일일퀘스트와 글로리 전장은 프로 키가 필요합니다." />
                    </StackPanel>
                </ScrollViewer>

                <!-- 관리자 -->
                <ScrollViewer x:Name="AdminPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="관리자" Style="{StaticResource PageTitle}" />

                        <TextBlock Text="라이센스 키 발급" Style="{StaticResource Section}" Margin="0,0,0,8" />
                        <ui:Card Padding="16">
                            <StackPanel>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="종류" Style="{StaticResource RowDesc}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="NewTier" MinWidth="120" SelectedIndex="1">
                                            <ComboBoxItem Content="베이직 (탐험만)" />
                                            <ComboBoxItem Content="프로 (전체)" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="개수" Style="{StaticResource RowDesc}" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="KeyCount" Text="1" Width="70" TextAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="메모 (선택)" Style="{StaticResource RowDesc}" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="KeyNote" PlaceholderText="예: 구매자 닉네임" Width="200" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,8">
                                        <TextBlock Text="직접 지정 (선택, 1개일 때)" Style="{StaticResource RowDesc}" Margin="0,0,0,4" />
                                        <ui:TextBox x:Name="CustomKey" PlaceholderText="최대 16자 / 비우면 무작위" Width="200"
                                                    ToolTip="공백과 하이픈을 제외하고 4~16자까지 지정할 수 있습니다." />
                                    </StackPanel>
                                </WrapPanel>
                                <ui:Button Appearance="Primary" Content="발급" Click="IssueKeys_Click" />
                                <ui:TextBox x:Name="IssuedKeys" IsReadOnly="True" AcceptsReturn="True" Height="80" Margin="0,12,0,0"
                                            FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
                                            PlaceholderText="발급된 키가 여기에 표시되고 클립보드에 복사됩니다." />
                            </StackPanel>
                        </ui:Card>

                        <DockPanel Margin="0,14,0,8">
                            <ui:Button DockPanel.Dock="Right" Content="목록 새로고침" Click="LoadKeys_Click" />
                            <TextBlock Text="발급한 키" Style="{StaticResource Section}" Margin="0" VerticalAlignment="Center" />
                        </DockPanel>
                        <ui:Card Padding="4">
                            <ListBox x:Name="KeyList" FontFamily="Consolas, Malgun Gothic" FontSize="12" Height="220"
                                     BorderThickness="0" Background="Transparent" SelectionChanged="KeyList_SelectionChanged" />
                        </ui:Card>
                        <WrapPanel x:Name="KeyActions" Margin="0,8,0,0" IsEnabled="False">
                            <ui:Button Content="키 복사" Margin="0,0,8,8" Click="CopyKey_Click" />
                            <ui:Button Content="프로로 전환" Margin="0,0,8,8" Click="MakePro_Click" />
                            <ui:Button Content="베이직으로 전환" Margin="0,0,8,8" Click="MakeBasic_Click" />
                            <ui:Button Content="삭제" Appearance="Danger" Margin="0,0,8,8" Click="DeleteKey_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="AdminMessage" Style="{StaticResource RowDesc}" />
                    </StackPanel>
                </ScrollViewer>
                <!-- 로그 -->
                <DockPanel x:Name="LogPage" Visibility="Collapsed">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <ui:Button DockPanel.Dock="Right" Content="로그 폴더 열기" Click="OpenLogs_Click">
                            <ui:Button.Icon>
                                <ui:SymbolIcon Symbol="FolderOpen24" />
                            </ui:Button.Icon>
                        </ui:Button>
                        <TextBlock Text="로그" Style="{StaticResource PageTitle}" Margin="0" />
                    </DockPanel>
                    <ui:Card Padding="4" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">
                        <ListBox x:Name="LogList" FontFamily="Consolas, Malgun Gothic" FontSize="12"
                                 BorderThickness="0" Background="Transparent" />
                    </ui:Card>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
