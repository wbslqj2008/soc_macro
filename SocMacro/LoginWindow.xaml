<ui:FluentWindow x:Class="SocMacro.LoginWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="소오콘 매크로 - 라이센스" Width="420" Height="440" ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen" FontFamily="Malgun Gothic"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="소오콘 매크로" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1" Margin="36,8,36,28">
            <StackPanel x:Name="KeyPanel" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="Key24" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="라이센스 키 입력" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="구매하거나 받은 키를 입력해 주세요." HorizontalAlignment="Center" FontSize="12" Margin="0,0,0,22"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <ui:TextBox x:Name="KeyBox" PlaceholderText="XXXX-XXXX-XXXX" Margin="0,0,0,10" KeyDown="Key_KeyDown" />
                <CheckBox x:Name="RememberBox" Content="이 PC에서 키 기억하기" IsChecked="True" Margin="0,0,0,16" />
                <ui:Button x:Name="LoginButton" Appearance="Primary" Content="확인" HorizontalAlignment="Stretch"
                           Height="40" Click="Login_Click" />

                <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,14,0,0" FontSize="12"
                           Foreground="#E5484D" TextAlignment="Center" />
            </StackPanel>

            <StackPanel x:Name="BusyPanel" VerticalAlignment="Center" Visibility="Collapsed">
                <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Center" />
                <TextBlock Text="키를 확인하는 중..." HorizontalAlignment="Center" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
